<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
  <display-name>GuardLMS Sakai connector</display-name>
  <filter><filter-name>sakai.request</filter-name><filter-class>org.sakaiproject.util.RequestFilter</filter-class><init-param><param-name>tool.placement</param-name><param-value>none</param-value></init-param></filter>
  <filter-mapping><filter-name>sakai.request</filter-name><url-pattern>/*</url-pattern><dispatcher>REQUEST</dispatcher></filter-mapping>
  <listener><listener-class>org.sakaiproject.util.ToolListener</listener-class></listener>
  <servlet><servlet-name>guardlms</servlet-name><servlet-class>com.guardlms.sakai.GuardLmsServlet</servlet-class><load-on-startup>1</load-on-startup></servlet>
  <servlet-mapping><servlet-name>guardlms</servlet-name><url-pattern>/*</url-pattern></servlet-mapping>
</web-app>
